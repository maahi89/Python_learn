from sklearn.linear_model import LinearRegression
import numpy as np

# Input data (X)
X = np.array([[1], [2], [3], [4]])

# Output data (y)
y = np.array([2, 4, 6, 8])

# Create model
model = LinearRegression()

# Train model
model.fit(X, y)

# Predict new value
prediction = model.predict([[5]])

print(prediction)